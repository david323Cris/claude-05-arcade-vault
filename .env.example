# Base de la API para las peticiones hechas desde el servidor (Server Components, etc.).
# En el navegador se usan rutas relativas (/api/...), así que no hace falta definirla allí.
# Por defecto: http://localhost:3000
API_BASE_URL=http://localhost:3000

# Carpeta con los JSON del backend simulado (opcional). Por defecto: ./data
# Los tests la usan para no tocar los archivos versionados.
# DATA_DIR=data

# --- Contacto (SPEC 04) ---
# Clave de API de Resend (https://resend.com/api-keys). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Correo del equipo que recibe los mensajes del formulario de contacto.
# Con el remitente de sandbox (onboarding@resend.dev) Resend SOLO entrega a la dirección
# de la cuenta dueña de Resend; en desarrollo usa ese correo.
CONTACT_TO_EMAIL=

# Remitente de los correos. Por defecto: onboarding@resend.dev (sandbox de Resend).
# Para entregar a otros destinatarios hay que verificar un dominio propio en Resend (opcional).
# CONTACT_FROM_EMAIL=onboarding@resend.dev
