# Base de la API para las peticiones hechas desde el servidor (Server Components, etc.).
# En el navegador se usan rutas relativas (/api/...), así que no hace falta definirla allí.
# Por defecto: http://localhost:3000
API_BASE_URL=http://localhost:3000

# Carpeta con los JSON del backend simulado (opcional). Por defecto: ./data
# Los tests la usan para no tocar los archivos versionados.
# DATA_DIR=data
